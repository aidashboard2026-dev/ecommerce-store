# Backend local development settings.
# Copy this file to backend/.env and replace every value before starting the backend locally.
SECRET_KEY=replace-with-a-long-random-secret
INITIAL_ADMIN_NAME=Admin
INITIAL_ADMIN_EMAIL=admin@mail.com
INITIAL_ADMIN_PASSWORD=admin1234

# Upload directory — where product images are stored.
# In Docker: set to /app/uploads (matches the Docker named volume mount).
# For local dev outside Docker: leave blank to use backend/uploads/ auto-detection.
# UPLOAD_DIR=/app/uploads

# Public backend origin for image URL construction (frontend only — set in frontend .env).
# Leave blank in dev (Vite proxy handles /uploads routing).
# In production: set VITE_BACKEND_URL=https://api.mystore.com in frontend .env
