###############################################################################
# APPLICATION & ENVIRONMENT
###############################################################################

# Environment Stage Tag
# Description: Specifies the deployment environment stage (development, staging, or production).
# Used In: backend/app/core/config.py, backend/app/main.py (enforces Razorpay verification in production)
# Required: No (Defaults to 'development')
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Public
ENVIRONMENT=development

# API Version 1 Prefix
# Description: Routing prefix for REST endpoints.
# Used In: backend/app/main.py
# Required: No (Defaults to '/api/v1')
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Public
API_V1_STR=/api/v1

# Backend Project Name
# Description: Label representing the FastAPI application.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 'AdminDash Pro')
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
PROJECT_NAME=AdminDash Pro

# Backend Version Tag
# Description: Release version tag.
# Used In: backend/app/core/config.py
# Required: No (Defaults to '1.0.0')
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Public
VERSION=1.0.0


###############################################################################
# DATABASE (PostgreSQL)
###############################################################################

# Database server host address
# Description: Hostname of the PostgreSQL/Supabase database server instance.
# Used In: backend/app/core/config.py (Builds DATABASE_URL connection string)
# Required: Yes
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
POSTGRES_SERVER=aws-pooler.supabase.com

# Database username
# Description: Authentication user for PostgreSQL.
# Used In: backend/app/core/config.py
# Required: Yes
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
POSTGRES_USER=postgres.xxxxxxxxxxxxxxxxxxxx

# Database password
# Description: Secret credentials for database access.
# Used In: backend/app/core/config.py
# Required: Yes
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
POSTGRES_PASSWORD=xxxxxxxxxxxxxxxx

# PostgreSQL Database Name
# Description: Database name target.
# Used In: backend/app/core/config.py
# Required: Yes
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
POSTGRES_DB=postgres

# PostgreSQL Connection Port
# Description: Access port for postgres client connections.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 5432)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
POSTGRES_PORT=5432


###############################################################################
# INITIAL ADMIN SEED
###############################################################################

# Initial Seed Admin Username
# Description: Username set for initial admin account seeding.
# Used In: backend/app/core/config.py, startup seeder
# Required: No (Defaults to 'Admin')
# Environment: Development Only
# Backend Only
# Client Editable: Yes
# Security: Internal
INITIAL_ADMIN_NAME=Admin

# Initial Seed Admin Email
# Description: Email set for initial admin account seeding.
# Used In: backend/app/core/config.py, startup seeder
# Required: No (Defaults to 'admin@mail.com')
# Environment: Development Only
# Backend Only
# Client Editable: Yes
# Security: Internal
INITIAL_ADMIN_EMAIL=admin@mail.com

# Initial Seed Admin Password
# Description: Login password for initial admin account.
# Used In: backend/app/core/config.py, startup seeder
# Required: No
# Environment: Development Only
# Backend Only
# Client Editable: Yes
# Security: Sensitive
INITIAL_ADMIN_PASSWORD=admin1234


###############################################################################
# SECURITY & JWT
###############################################################################

# Cryptographic Token Hashing Secret
# Description: Core symmetric secret key used to sign and verify administrative and customer JWT sessions.
# Used In: backend/app/core/config.py
# Required: Yes
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
# Note: Minimum 32 characters required. Generate one using secrets.token_hex(32).
SECRET_KEY=1fe431a7ce886740a82e163b510cbaae8e32815bcec8de9f58328a73d05d3e3d

# JWT signature hash algorithm
# Description: Encryption algorithm.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 'HS256')
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
ALGORITHM=HS256

# Expiration window (minutes) for Customer auth token
# Description: JWT lifetime for customer sessions.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 480 - 8 hours)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Expiration window (minutes) for Administrative auth token
# Description: JWT lifetime for admin dashboard sessions.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 60 - 1 hour)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
ADMIN_TOKEN_EXPIRE_MINUTES=60

# Secure Cookie Header Switch
# Description: Toggles the Secure flag on cookie headers (requires HTTPS).
# Used In: backend/app/modules/auth/router.py, backend/app/modules/offers/router.py, backend/app/api/v1/endpoints/auth.py
# Required: No (Defaults to true)
# Environment: Development (false) + Production (true)
# Backend Only
# Client Editable: No
# Security: Internal
AUTH_COOKIE_SECURE=false


###############################################################################
# CORS ORIGINS
###############################################################################

# Comma-separated allowed client origins
# Description: Whitelist for frontend client CORS requests.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Public
BACKEND_CORS_ORIGINS=http://localhost:5173

# Primary production client website URL (automatically appended to CORS whitelist)
# Description: Production frontend address.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Production Only
# Backend Only
# Client Editable: Yes
# Security: Public
PRODUCTION_FRONTEND_URL=


###############################################################################
# EMAIL DELIVERY (Resend / SMTP / Simulation)
###############################################################################

# --- Resend Service (Recommended Primary) ---

# Enable/Disable Resend API delivery
# Description: Toggle to route unified emails through Resend REST API client.
# Used In: backend/app/shared/email/service.py
# Required: No (Defaults to true)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
RESEND_ENABLED=true

# Resend API Auth token
# Description: Secret API key starting with 're_'.
# Used In: backend/app/core/config.py, backend/app/shared/email/service.py
# Required: Yes (If Resend is enabled)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
RESEND_API_KEY=

# Outbound sender email address
# Description: Verified outbound address registered on Resend.
# Used In: backend/app/core/config.py
# Required: No (Defaults to onboarding@resend.dev)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sender display name
# Description: Display name shown in email client Inbox.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
RESEND_FROM_NAME=My Designers

# Target address for replies
# Description: Target destination address for recipient replies.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
RESEND_REPLY_TO=

# Timeout limit (seconds) for Resend requests
# Description: Request HTTP timeout.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 15)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
RESEND_TIMEOUT=15

# --- SMTP fallbacks ---

# Enable/Disable SMTP fallback delivery
# Description: Toggle to route emails via SMTP protocol if Resend fails or is disabled.
# Used In: backend/app/shared/email/service.py
# Required: No (Defaults to true)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
SMTP_ENABLED=true

# Outbound SMTP server address
# Description: Host hostname of the SMTP server.
# Used In: backend/app/core/config.py
# Required: Yes (If SMTP fallback is enabled)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SMTP_HOST=

# SMTP server port
# Description: Access port. TLS/STARTTLS: 587, SSL: 465.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 587)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SMTP_PORT=587

# SMTP account login username
# Description: Auth username for SMTP client connections.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Sensitive
SMTP_USER=

# SMTP account login password
# Description: Auth password.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
SMTP_PASSWORD=

# Enable STARTTLS connection handshake
# Description: Toggles TLS socket security (highly recommended for port 587).
# Used In: backend/app/core/config.py
# Required: No (Defaults to true)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SMTP_TLS=true

# Enable direct SSL connection wrapping
# Description: Toggles direct SSL socket secure connection (recommended for port 465).
# Used In: backend/app/core/config.py
# Required: No (Defaults to false)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SMTP_SSL=false

# SMTP Sender address
# Description: Sender identity email for fallback dispatches.
# Used In: backend/app/core/config.py
# Required: No (Defaults to noreply@yourdomain.com)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
SMTP_FROM_EMAIL=noreply@yourdomain.com

# SMTP Sender display name
# Description: Display name shown in email client Inbox for SMTP sends.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
SMTP_FROM_NAME=My Designers

# SMTP Reply To address
# Description: Outbound reply routing address.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
SMTP_REPLY_TO=

# SMTP socket communication timeout
# Description: Limit (seconds) to establish SMTP session.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 15)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SMTP_TIMEOUT=15


###############################################################################
# STORE DETAILS & BRANDING
###############################################################################

# Store title
# Description: Primary brand title used on storefront and template branding headers.
# Used In: backend/app/core/config.py, backend/app/shared/email/service.py (branding compiler)
# Required: No (Defaults to 'My Designers')
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
STORE_NAME=My Designers

# Store website URL
# Description: Main home URL for SEO and footers.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
STORE_URL=http://localhost:5173

# Store logo image URL
# Description: Direct URL to the store logo for templates and layouts.
# Used In: backend/app/core/config.py, backend/app/shared/email/service.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
STORE_LOGO_URL=

# Recipient address for customer support requests
# Description: Recipient email address for inbound 'Contact Us' notifications.
# Used In: backend/app/core/config.py, backend/app/modules/contact/email_service.py
# Required: No (Defaults to support@mydesigners.in)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
SUPPORT_EMAIL=support@mydesigners.in

# Customer helpline number
# Description: Renders in transactional email templates and store configurations.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
SUPPORT_PHONE=+91 9876543210

# Social Profile Links
# Description: Social media redirection buttons.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
FACEBOOK_URL=https://facebook.com/mydesigners
INSTAGRAM_URL=https://instagram.com/mydesigners
LINKEDIN_URL=https://linkedin.com/company/mydesigners
TWITTER_URL=
YOUTUBE_URL=
WHATSAPP_NUMBER=

# Physical business office address
# Description: Renders in the footer of billing invoices and templates.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
BUSINESS_ADDRESS=


###############################################################################
# GOOGLE RECAPTCHA (Optional)
###############################################################################

# Google reCAPTCHA v3 private secret key
# Description: Key used to authenticate user captcha status.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Sensitive
RECAPTCHA_SECRET_KEY=

# Minimum validation passing score threshold
# Description: Threshold score (0.0 to 1.0) under which requests are flagged as bots.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 0.5)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
RECAPTCHA_MIN_SCORE=0.5


###############################################################################
# SUPABASE STORAGE (Cloud Native Assets)
###############################################################################

# Base API endpoint URL for Supabase project instance
# Description: Supabase URL target for cloud-native asset storage.
# Used In: backend/app/core/config.py, backend/app/main.py
# Required: Yes (In production)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SUPABASE_URL=https://eizowgupqtyikonkaxqa.supabase.co

# Public client-side anon key
# Description: Anon key.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Public
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Superuser service role key
# Description: Admin key used to upload and delete files, bypassing RLS.
# Used In: backend/app/core/config.py, backend/app/main.py
# Required: Yes (In production)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Storage Bucket Names
# Description: Isolated buckets.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
SUPABASE_PRODUCT_BUCKET=product-images
SUPABASE_CUSTOM_PRODUCT_BUCKET=custom-product-images
SUPABASE_BANNER_BUCKET=banners
SUPABASE_CATEGORY_BUCKET=category-images

# Local fallback uploads directory path
# Description: Local fallback directory for asset writes if Supabase is unconfigured (development only).
# Used In: backend/app/core/config.py, backend/app/main.py
# Required: No (Defaults to /app/uploads)
# Environment: Development Only
# Backend Only
# Client Editable: No
# Security: Internal
UPLOAD_DIR=/app/uploads

# Backend Host API URL
# Description: URL host of the running backend server.
# Used In: backend/app/core/config.py
# Required: No
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
BACKEND_URL=


###############################################################################
# RAZORPAY PAYMENTS
###############################################################################

# Razorpay dashboard API integration key
# Description: Public ID of Razorpay payment gateway integration.
# Used In: backend/app/core/config.py
# Required: Yes (In production)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Internal
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx

# Razorpay API verification secret
# Description: Private key used to verify payments and sign checkout transactions.
# Used In: backend/app/core/config.py
# Required: Yes (In production)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
# Warning: Refuses startup in production if set to placeholder.
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# Signature token used to authorize incoming payment webhooks
# Description: Signature token for webhook validation.
# Used In: backend/app/core/config.py
# Required: Yes (In production)
# Environment: Development + Production
# Backend Only
# Client Editable: No
# Security: Critical Secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_dev1234

# Order checkout session timeout window (minutes)
# Description: Expiration duration for unpaid checkout session.
# Used In: backend/app/core/config.py
# Required: No (Defaults to 15)
# Environment: Development + Production
# Backend Only
# Client Editable: Yes
# Security: Public
RAZORPAY_ORDER_TIMEOUT_MINUTES=15


###############################################################################
# DOCKER RUNTIME SPECIAL FLAGS
###############################################################################

# Cache store connection URL
# Description: Host address for redis cache server.
# Used In: docker-compose.yml
# Required: No (Defaults to redis://redis:6379)
# Environment: Production Only
# Backend Only
# Client Editable: No
# Security: Internal
REDIS_URL=redis://redis:6379
