###############################################################################
# APPLICATION & BRANDING
###############################################################################

# Store title
# Description: Brand name displayed in header titles, register pages, and copyright text.
# Used In: StoreHeader, StoreFooter, CartHeader, RegisterForm, LoginPage, SupportPage, App.jsx, Header.jsx
# Required: No (Defaults to 'My Designers')
# Environment: Development + Production
# Frontend Only
# Client Editable: Yes
# Security: Public
VITE_STORE_NAME=My Designers

# Store website URL
# Description: Public client-side URL.
# Used In: App.jsx, SettingsPage.jsx
# Required: No (Defaults to 'https://mydesigners.com')
# Environment: Development + Production
# Frontend Only
# Client Editable: Yes
# Security: Public
VITE_STORE_URL=https://mydesigners.com

# Target Backend Server Origin
# Description: Base URL pointing to the running FastAPI server. 
# Used In: CategorySection, productUtils, OffersPage, CategoriesPage
# Required: No (Defaults to empty, which uses relative path proxy targets)
# Environment: Development + Production
# Frontend Only
# Client Editable: Yes
# Security: Public
VITE_BACKEND_URL=

# Core API prefix routing
# Description: Path prefix used to query endpoints.
# Used In: services/api.js, shared/services/api.js
# Required: No (Defaults to '/api/v1')
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_API_URL=/api/v1


###############################################################################
# RAZORPAY PAYMENTS
###############################################################################

# Razorpay dashboard API integration key
# Description: Public ID of Razorpay payment gateway integration, loaded by checkout script.
# Used In: CheckoutPage.jsx
# Required: Yes (In production)
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx


###############################################################################
# SOCIAL REDIRECTION LINKS
###############################################################################

# Facebook Profile Link
# Description: Redirection URL for Facebook icons in footer.
# Used In: StoreFooter.jsx
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: Yes
# Security: Public
VITE_FACEBOOK_URL=https://facebook.com/mydesigners

# Instagram Profile Link
# Description: Redirection URL for Instagram icons in footer.
# Used In: StoreFooter.jsx
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: Yes
# Security: Public
VITE_INSTAGRAM_URL=https://instagram.com/mydesigners

# WhatsApp Contact Number
# Description: Phone number prefix (with country code) used to build chat links.
# Used In: StoreFooter, custom_product_card, CustomProductDetailsPage, CustomProductDetailsPages.jsx
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: Yes
# Security: Public
VITE_WHATSAPP_NUMBER=+919876543210


###############################################################################
# FIREBASE SDK INTEGRATION
###############################################################################

# Firebase API Authorization Key
# Description: Client key used to authorize SDK client queries.
# Used In: firebase.js, main.jsx
# Required: Yes (If Firebase integration is used)
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_API_KEY=

# Firebase Auth routing domain
# Description: Auth routing domain.
# Used In: firebase.js
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase project ID
# Description: Project ID.
# Used In: firebase.js
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_PROJECT_ID=

# Firebase storage bucket target
# Description: Bucket name for Firebase storage writes.
# Used In: firebase.js
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_STORAGE_BUCKET=

# Firebase messaging sender ID
# Description: Sender ID for Firebase cloud messaging.
# Used In: firebase.js
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase dashboard Application ID
# Description: Client app identifier.
# Used In: firebase.js
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_APP_ID=

# Firebase measurement ID
# Description: Google Analytics tag.
# Used In: firebase.js
# Required: No
# Environment: Development + Production
# Frontend Only
# Client Editable: No
# Security: Public
VITE_FIREBASE_MEASUREMENT_ID=


###############################################################################
# DEVELOPMENT SERVER CONFIG
###############################################################################

# Dev server API routing proxy target
# Description: Target backend port routing for Vite developer server proxy.
# Used In: vite.config.js
# Required: No (Defaults to http://localhost:8000)
# Environment: Development Only
# Frontend Only
# Client Editable: No
# Security: Internal
VITE_PROXY_TARGET=http://localhost:8000
